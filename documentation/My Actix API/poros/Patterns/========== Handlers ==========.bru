meta {
  name: ========== Handlers ==========
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/pattern
  body: json
  auth: none
}

body:json {
  {
    "flight_id": "log",
    "log_group": "str_field_1",
    "name": "meowww",
    "pattern": [
      {
        "type": "RegexPattern",
        "value": {
          "field": "str_field_1",
          "pattern_string": "^(?P<first>.{2}).*(?P<last>.{2})$"
        }
      },
      {
        "type": "RegexPattern",
        "value": {
          "field": "str_field_2",
          "pattern_string": "^(?P<first>.{2}).*(?P<last2>.{2})$"
        }
      }
    ],
    "tenant": "",
    "try_parse": true
  }
}
